# Port the Express server listens on. Optional, defaults to 3000.
PORT=3000

# Runtime environment: development | test | production. Optional, defaults
# to development. Controls things like the "secure" flag on refresh cookies.
NODE_ENV=development

# PostgreSQL connection. All required.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Secret used to sign/verify access & refresh JWTs (HS256). Required, must
# be at least 16 characters. Never commit a real value.
JWT_SECRET=

# Comma-separated list of allowed CORS origins, e.g.
# "http://localhost:5173,https://app.example.com". Optional, defaults to
# an empty allow-list (no cross-origin requests permitted).
CORS_ORIGIN=http://localhost:5173

# --- Not yet used ---
# PayMongo integration is not implemented yet. When it is, these must be
# required (not optional) so an unsigned/unverifiable webhook fails hard
# instead of being silently accepted.
# PAYMONGO_SECRET_KEY=
# PAYMONGO_WEBHOOK_SECRET=
